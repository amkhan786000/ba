# Front door of the server (only used with COMPOSE_PROFILES=https): Caddy holds ports 80 and 443, sends each
# visitor to the right app by the name they opened, and gets and renews free Let's Encrypt certificates by itself.
#
#   https://biharanjuman.com, https://www.biharanjuman.com -> the Bihar Anjuman website (container
#                                                             biharanjuman-frontend, which joins this network
#                                                             with CADDY_NETWORK=rahbar_default)
#   https://rahbar.biharanjuman.com                        -> Rahbar
#   http://<server-ip> (any other name)                    -> Rahbar, plain HTTP (no certificate for an IP)
#
# http:// on the three names is sent on to https:// automatically. Port 443 must be open (sudo ufw allow 443/tcp).
#
# Upstreams are named by container name, never by compose service name: the website's service is also called
# "frontend", and once it joins this network the name "frontend" points to both apps.
{
	# Keep the visitor's address (X-Forwarded-For) when the request comes from inside this server: the website's
	# nginx calls Rahbar's API through here and passes the visitor on. Visitors on the internet can't fake it.
	servers {
		trusted_proxies static private_ranges
	}
}

# The Bihar Anjuman website (biharanjuman.com repository).
biharanjuman.com, www.biharanjuman.com {
	encode gzip
	reverse_proxy biharanjuman-frontend:80
}

# Rahbar on its own name.
rahbar.biharanjuman.com {
	encode gzip
	reverse_proxy rahbar-frontend:80
}

# Rahbar on the server's IP address and any other name, plain HTTP. The website's API calls
# (http://host.docker.internal/api/public/website) come in here too.
:80 {
	encode gzip
	reverse_proxy rahbar-frontend:80
}
