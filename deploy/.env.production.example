# /opt/rahbar/.env on the Contabo server. Copy this file there, fill it in, and keep it private:
#   chmod 600 /opt/rahbar/.env
# It never goes into git. Use NEW passwords here (not the ones from your laptop).
# Generate strong values with:  openssl rand -base64 32

# ---- Database (MySQL runs in Docker on the same server) ----
DB_NAME=rahbar
DB_USER=rahbar
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ---- Sign-in tokens: a long random string (at least 32 characters) ----
JWT_SECRET=
JWT_EXPIRATION_MS=28800000

# ---- Email (Gmail: the address + a 16-letter app password without spaces) ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ---- Address people use to open the site ----
# Without a domain: http://<server-ip>. With a domain + HTTPS: https://your.domain
PUBLIC_URL=http://YOUR_SERVER_IP

# ---- Optional HTTPS (once a domain points to this server) ----
# DOMAIN=rahbar.example.org
# HTTP_BIND=127.0.0.1:8080
# COMPOSE_PROFILES=https

# ---- Java memory for the backend container (raise it on bigger servers) ----
JAVA_OPTS=-Xms256m -Xmx768m

# ---- Set by deploy.sh: which image version is running (don't edit) ----
# TAG=
